{
	"name": "talks",
	"version": "0.0.0",
	"private": true,
	"description": "Josh Goldberg's conference and meetup talks, as Slidev decks that build to PowerPoint.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JoshuaKGoldberg/talks.git"
	},
	"license": "MIT",
	"author": {
		"name": "Josh Goldberg",
		"email": "git@joshuakgoldberg.com"
	},
	"type": "module",
	"scripts": {
		"build": "pnpm --recursive --workspace-concurrency 2 build",
		"format": "prettier .",
		"lint": "eslint . --max-warnings 0",
		"lint:knip": "knip",
		"lint:packages": "pnpm dedupe --check",
		"lint:spelling": "cspell \"**\" \".github/**/*\"",
		"lint:talk-files": "node scripts/talk-files.ts check",
		"prepare": "husky",
		"test": "pnpm --recursive test",
		"upload": "node scripts/talk-files.ts upload"
	},
	"lint-staged": {
		"*": "prettier --ignore-unknown --write"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
		"@eslint/js": "10.0.1",
		"@eslint/markdown": "9.0.0",
		"@slidev/cli": "53.1.0",
		"@slidev/client": "53.1.0",
		"@slidev/parser": "53.1.0",
		"@slidev/types": "53.1.0",
		"@types/node": "26.6.2",
		"@vitest/eslint-plugin": "1.6.27",
		"console-fail-test": "0.10.0",
		"cspell": "10.5.1",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-jsdoc": "65.5.0",
		"eslint-plugin-jsonc": "3.4.1",
		"eslint-plugin-markdown-links": "0.9.1",
		"eslint-plugin-n": "18.5.0",
		"eslint-plugin-package-json": "1.14.0",
		"eslint-plugin-perfectionist": "5.14.0",
		"eslint-plugin-regexp": "3.3.1",
		"eslint-plugin-vue": "10.12.1",
		"eslint-plugin-yml": "3.10.0",
		"husky": "9.1.7",
		"knip": "6.47.0",
		"lint-staged": "17.6.0",
		"prettier": "3.10.1",
		"prettier-plugin-curly": "0.4.1",
		"prettier-plugin-packagejson": "3.1.0",
		"prettier-plugin-padding-lines": "0.1.0",
		"prettier-plugin-sentences-per-line": "0.2.4",
		"prettier-plugin-sh": "0.20.0",
		"slidev2pptx": "0.1.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.73.0",
		"vitest": "5.1.0",
		"vue": "3.5.45",
		"vue-eslint-parser": "10.4.2"
	},
	"packageManager": "pnpm@12.21.0",
	"engines": {
		"node": "^22.22.0 || >=24.0.0"
	}
}
